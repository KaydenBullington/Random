int main() {
	int tries = 0;
	vector<int> nums = { 5, 4, 3, 2, 1 };

	while(!is_sorted(begin(nums), end(nums))) {
		//Implementation for bogo sort
		static std::mt19937 engine{ std::random_device{}() }; //random number generator
		shuffle(nums.begin(), nums.end(), engine);
